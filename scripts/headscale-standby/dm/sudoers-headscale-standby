# /etc/sudoers.d/headscale-standby (mode 440) on dm.
# The forced-command wrapper may run only the root-side helper, with exactly these verbs.
maxjeffwell ALL=(root) NOPASSWD: /usr/local/sbin/headscale-standby-dmside.sh export
maxjeffwell ALL=(root) NOPASSWD: /usr/local/sbin/headscale-standby-dmside.sh config
maxjeffwell ALL=(root) NOPASSWD: /usr/local/sbin/headscale-standby-dmside.sh state
maxjeffwell ALL=(root) NOPASSWD: /usr/local/sbin/headscale-standby-dmside.sh receive-db
maxjeffwell ALL=(root) NOPASSWD: /usr/local/sbin/headscale-standby-dmside.sh start
