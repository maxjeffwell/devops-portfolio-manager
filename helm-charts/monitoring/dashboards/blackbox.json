{
  "uid": "blackbox-probes",
  "title": "Blackbox Probes",
  "tags": [
    "blackbox",
    "synthetic",
    "edge"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "graphTooltip": 1,
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "description": "Outside-in synthetic monitoring from the blackbox exporter on the VPS: HTTP endpoints, ICMP over Tailscale, DNS resolution time. Metrics live in kube-prometheus's Prometheus (datasource uid 'prometheus'), not Mimir.",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Public endpoints up",
      "description": "Share of tier=public HTTP probes passing right now.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(probe_success{job=~\"http-public(-auth)?\"} == 1) / count(probe_success{job=~\"http-public(-auth)?\"})",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.9
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "orientation": "auto",
        "justifyMode": "center"
      }
    },
