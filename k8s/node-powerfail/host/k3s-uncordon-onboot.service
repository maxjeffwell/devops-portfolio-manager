[Unit]
Description=Uncordon k3s node after UPS-triggered drain
After=k3s.service k3s-agent.service network-online.target tailscaled.service
Wants=network-online.target
ConditionPathExists=/var/lib/nut-drained.flag

[Service]
Type=oneshot
RemainAfterExit=no
ExecStart=/usr/local/sbin/k3s-uncordon-onboot.sh

[Install]
WantedBy=multi-user.target
